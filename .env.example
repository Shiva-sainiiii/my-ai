# =================================================================
# PERSONAL AI GATEWAY — ENVIRONMENT VARIABLES
# Copy this file's contents into Vercel Project Settings > Environment
# Variables. Fill in only what you have — the gateway automatically
# skips any provider with no keys configured.
# =================================================================

# --- YOUR MASTER KEY -------------------------------------------
# This is what YOU use to call the gateway. Generate a random one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_MASTER_KEY=

# --- VERCEL KV (required for rate-limit tracking) ---------------
# Create free from Vercel dashboard: Storage tab -> Create Database -> KV
# Vercel auto-fills these for you when you connect the KV store to
# this project — you usually don't need to set them by hand.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=

# --- GROQ --------------------------------------------------------
# Get free keys: https://console.groq.com/keys
# ⚠️ ORG-LEVEL LIMIT: extra keys from the SAME account do NOT add
# quota (30 rpm / model-dependent rpd is shared across all your keys).
# The gateway only uses GROQ_KEY_1 — set GROQ_KEY_2 etc. ONLY if it's
# from a genuinely separate Groq account (different email/signup).
GROQ_KEY_1=
GROQ_KEY_2=

# --- GOOGLE AI STUDIO ---------------------------------------------
# Get free keys: https://aistudio.google.com/apikey
# ⚠️ PROJECT-LEVEL LIMIT: a key just from a different Google account
# but the SAME Cloud project shares quota. The gateway only uses
# GOOGLE_AI_KEY_1 — add GOOGLE_AI_KEY_2 only if it's from a separate
# Google Cloud project (new Google account = easiest way to get one).
GOOGLE_AI_KEY_1=
GOOGLE_AI_KEY_2=

# --- OPENROUTER ----------------------------------------------------
# Get free keys: https://openrouter.ai/settings/keys
# ✅ PER-ACCOUNT LIMIT — rotation genuinely works here. Each account
# gets its own 20 rpm / 50 rpd (or 1000 rpd if that account has ever
# added $10+ credit). Add as many as you have accounts for.
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=

# --- CLOUDFLARE WORKERS AI ------------------------------------------
# 1. Get Account ID: https://dash.cloudflare.com -> right sidebar
# 2. Create API Token: My Profile -> API Tokens -> Create Token
#    -> use the "Workers AI" template (needs Account.Workers AI:Edit)
# ⚠️ ACCOUNT-LEVEL LIMIT: 10,000 neurons/day is shared across the
# WHOLE account, not per token. The gateway only uses CF_KEY_1 —
# add CF_KEY_2/CF_ACCOUNT_ID_2 only from a genuinely separate
# Cloudflare account.
CF_KEY_1=
CF_ACCOUNT_ID_1=
CF_KEY_2=
CF_ACCOUNT_ID_2=

# --- POLLINATIONS ----------------------------------------------------
# Works with NO key (anonymous), but capped ~1 req/15sec + watermarked.
# For a reliable fallback, get a free sk_ key: https://enter.pollinations.ai
# ✅ PER-KEY LIMIT — rotation works if you make multiple accounts.
POLLINATIONS_KEY_1=
