# =================================================================
# PERSONAL AI GATEWAY — ENVIRONMENT VARIABLES
# Copy this file's contents into Vercel Project Settings > Environment
# Variables. Fill in only what you have — the gateway automatically
# skips any provider with no keys configured.
# =================================================================

# --- YOUR MASTER KEY -------------------------------------------
# This is what YOU use to call the gateway. Generate a random one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_MASTER_KEY=

# --- REDIS (required for rate-limit tracking) --------------------
# Create free from Vercel dashboard: Storage tab -> Browse Storage ->
# Redis (marketplace integration). Use custom prefix "KV" when
# connecting so the var below gets created automatically.
# The gateway's rateLimiter.js checks KV_REDIS_URL first, then falls
# back to REDIS_URL, then KV_URL — whichever your integration named it.
# You usually don't need to set this by hand once connected.
KV_REDIS_URL=

# --- GROQ --------------------------------------------------------
# Get free keys: https://console.groq.com/keys
# ⚠️ ORG-LEVEL LIMIT BY DEFAULT: keys from the SAME account do NOT
# add quota (30 rpm / model-dependent rpd shared across all keys on
# one account). registry.js currently has orgLevelLimit:false for
# Groq because these 4 keys are confirmed to be from 4 SEPARATE
# accounts — only fill in a 5th slot if it's from yet another new
# account, never a second key from an account already used below.
GROQ_KEY_1=
GROQ_KEY_2=
GROQ_KEY_3=
GROQ_KEY_4=

# --- GOOGLE AI STUDIO ---------------------------------------------
# Get free keys: https://aistudio.google.com/apikey
# ⚠️ PROJECT-LEVEL LIMIT BY DEFAULT: a key just from a different
# Google account but the SAME Cloud project still shares quota.
# registry.js currently has orgLevelLimit:false because these 4 keys
# are confirmed to be from 4 separate Google accounts, each with its
# own project. Same rule as Groq — only add more from a new account.
GOOGLE_AI_KEY_1=
GOOGLE_AI_KEY_2=
GOOGLE_AI_KEY_3=
GOOGLE_AI_KEY_4=

# --- OPENROUTER ----------------------------------------------------
# Get free keys: https://openrouter.ai/settings/keys
# ✅ PER-ACCOUNT LIMIT — rotation genuinely works here. Each account
# gets its own 20 rpm / 50 rpd (or 1000 rpd if that account has ever
# added $10+ credit).
OPENROUTER_KEY_1=
OPENROUTER_KEY_2=
OPENROUTER_KEY_3=
OPENROUTER_KEY_4=

# --- CLOUDFLARE WORKERS AI ------------------------------------------
# 1. Get Account ID: https://dash.cloudflare.com -> right sidebar
# 2. Create API Token: My Profile -> API Tokens -> Create Token
#    -> use the "Workers AI" template (needs Account.Workers AI:Edit)
# ⚠️ ACCOUNT-LEVEL LIMIT BY DEFAULT: 10,000 neurons/day is shared
# across the WHOLE account, not per token. registry.js currently has
# orgLevelLimit:false because these 4 key+accountId pairs are
# confirmed to be from 4 separate Cloudflare accounts.
CF_KEY_1=
CF_ACCOUNT_ID_1=
CF_KEY_2=
CF_ACCOUNT_ID_2=
CF_KEY_3=
CF_ACCOUNT_ID_3=
CF_KEY_4=
CF_ACCOUNT_ID_4=

# --- POLLINATIONS ----------------------------------------------------
# Works with NO key (anonymous), but capped ~1 req/15sec + watermarked.
# For a reliable fallback, get a free sk_ key: https://enter.pollinations.ai
# ✅ PER-KEY LIMIT — rotation works if you make multiple accounts.
POLLINATIONS_KEY_1=
